# .gitignore for Solvy-study-agent (Python project)

.vscode/

# Byte-compiled / cached
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.env
.env.local

# Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Testing / coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# C extensions
*.so

# Mypy / type checkers
.mypy_cache/
.pyre/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Jupyter
.ipynb_checkpoints

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Secrets / keys
*.pem
*.key
secret_settings.py
local_settings.py

# Node (if present)
node_modules/

# Misc
.cache/